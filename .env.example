# AI 코치와 AI 루틴 조정에 필요합니다. 이 파일을 .env.local로 복사한 뒤 값을 넣으세요.
# 키가 없어도 규칙 기반 루틴은 동작합니다.
ANTHROPIC_API_KEY=

# 선택: 사용할 모델. 비워 두면 claude-opus-5-5
# 비용을 낮추려면 claude-sonnet-5-5 또는 claude-haiku-5-5
ANTHROPIC_MODEL=

# 선택: Anthropic 호환 게이트웨이를 쓸 때만. 비워 두면 Anthropic 공식 API를 씁니다.
# 예) BAZE API Gateway: https://factchat-cloud.mindlogic.ai/v1/gateway/claude
ANTHROPIC_BASE_URL=

# 같은 Wi-Fi 휴대폰 테스트 시 실제 개발 서버 IP/호스트만 쉼표로 추가합니다.
# 와일드카드/전체 IP 대역은 넣지 마세요. 예: 192.168.0.23
DEV_ALLOWED_ORIGINS=
