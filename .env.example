# AI 코치와 AI 루틴 조정에 필요합니다. 이 파일을 .env.local로 복사한 뒤 값을 넣으세요.
# 키가 없어도 규칙 기반 루틴은 동작합니다.
ANTHROPIC_API_KEY=

# 선택: 사용할 모델. 비워 두면 claude-opus-5-5
# 비용을 낮추려면 claude-sonnet-5-5 또는 claude-haiku-5-5
ANTHROPIC_MODEL=

# 선택: Anthropic 호환 게이트웨이를 쓸 때만. 비워 두면 Anthropic 공식 API를 씁니다.
# 예) BAZE API Gateway: https://factchat-cloud.mindlogic.ai/v1/gateway/claude
ANTHROPIC_BASE_URL=

# 같은 Wi-Fi 휴대폰 테스트 시 실제 개발 서버 IP/호스트만 쉼표로 추가합니다.
# 와일드카드/전체 IP 대역은 넣지 마세요. 예: 192.168.0.23
DEV_ALLOWED_ORIGINS=

# ---- 공개 배포(프로덕션)에서 필요한 값 ----
# 로그인(GitHub OAuth) 설정이 없으면 프로덕션에서는 AI 코치와 루틴 조정이 닫혀요. 기본 루틴과 안내는 계속 나와요.
# GitHub 설정: https://github.com/settings/developers 에서 OAuth App을 만들고
#   Authorization callback URL = <AUTH_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 로그인 쿠키 서명용. 32자 이상 무작위 문자열: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# 서비스 주소(https). 예: https://ongi-sanhu.vercel.app
AUTH_URL=

# 하루 사용량 저장소(Upstash Redis REST). Vercel Marketplace에서 연결하면 KV_REST_API_URL / KV_REST_API_TOKEN으로 자동 입력돼요.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 선택: 전체 하루 합계 한도(기본 500회). 사용자별 한도는 코치 20회 / 루틴 조정 5회로 고정이에요.
AI_DAILY_GLOBAL_LIMIT=

# ---- 가장 간단한 공개 시연: 시연 코드 (GitHub 로그인·Redis 없이) ----
# 8자 이상. 이 코드를 아는 사람만 AI 코치와 루틴 조정을 쓸 수 있어요. AUTH_SECRET도 함께 필요해요.
# 프로덕션에서 Redis가 없으면 사용 횟수는 서버 인스턴스별로 세므로 한도가 엄밀하지 않아요. 시연용으로만 쓰세요.
DEMO_PASSCODE=
